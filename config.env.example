# Read by the scripts. Claude is not allowed to edit this file — change it yourself.

COMP=
KAGGLE_USER=

# The notebook whose saved version holds features.csv (the one that scored 0.3770).
# Find the slug with:  kaggle kernels list --mine      (or from the URL kaggle.com/code/ambruhsia/<slug>)
# Add /<version> at the end to pin a specific saved version.
MAIN_KERNEL=


# csv = upload submission.csv from here. kernel = code competition (submission must come from a notebook).
SUBMIT_MODE=

# Set to the competition's daily submission limit minus one, so you always keep a slot for yourself.
# Kaggle's day resets at 00:00 UTC (05:30 IST).
MAX_SUBS_PER_DAY=

# CV improvement a change needs before it is kept.
MIN_GAIN=

# Your team name as shown on the leaderboard (optional — improves the rank lookup).
TEAM_NAME=
